      "name": "SoilSense",
      "pillar": "Agriculture & Food Security",
      "status": "live",
      "repo_strategy": "separate_repo",
      "repo": "https://github.com/afghanistan-development-initiative/soilsense",
      "app_url": "https://soilsense-npwqirrz7pqkrtq5eidw4v.streamlit.app",
      "maps": ["soil health", "erosion risk", "degradation probability", "soil organic carbon", "pH", "nitrogen"],
      "data_sources": ["isric_soilgrids", "fao_land_resources"],
      "outputs": ["soil score", "risk class", "recovery recommendation", "printable soil report"],
      "next_build": ["province soil atlas", "district restoration priority", "salinity and drainage layer"]
    },
